# promotion-agent v4 — Claude Code Plugin
# Copy to .env and fill in your credentials

# ── 知乎 (Zhihu) — Cookie auth ──
# Auto-extract: python3 get_cookies.py
# Or manually: F12 → Network → Cookie header
PROMOTE_ZHIHU_COOKIE=

# ── 掘金 (Juejin) — Cookie auth ──
# Auto-extract: python3 get_cookies.py
PROMOTE_JUEJIN_COOKIE=

# ── CSDN — Cookie auth ──
# Auto-extract: python3 get_cookies.py
PROMOTE_CSDN_COOKIE=

# ── X / Twitter — OAuth 1.0a ──
# 从 developer.x.com 获取
PROMOTE_X_CONSUMER_KEY=
PROMOTE_X_CONSUMER_SECRET=
PROMOTE_X_ACCESS_TOKEN=
PROMOTE_X_ACCESS_TOKEN_SECRET=

# ── 微信公众号 — AppID + Secret ──
# 从微信公众平台获取
PROMOTE_WECHAT_APP_ID=
PROMOTE_WECHAT_APP_SECRET=

# ── 小红书 ──
# Auth managed by xiaohongshu-mcp (QR code login)
# No env vars needed

# ── 博客园 (CNBlogs) — MetaWeblog API ──
# 从 https://i.cnblogs.com/settings#enableApiAccess 获取
PROMOTE_CNBLOGS_BLOG_URL=
PROMOTE_CNBLOGS_USERNAME=
PROMOTE_CNBLOGS_TOKEN=

# ── Reddit — OAuth ──
PROMOTE_REDDIT_CLIENT_ID=
PROMOTE_REDDIT_CLIENT_SECRET=
PROMOTE_REDDIT_USERNAME=
PROMOTE_REDDIT_PASSWORD=

# ── Dev.to — API Key ──
# 从 https://dev.to/settings/extensions 获取
PROMOTE_DEVTO_API_KEY=

# ── LinkedIn — OAuth 2.0 ──
# 手动获取 access_token (expires in 60 days)
PROMOTE_LINKEDIN_ACCESS_TOKEN=

# ── Product Hunt — OAuth 2.0 ──
# 从 https://www.producthunt.com/v2/oauth/applications 获取
PROMOTE_PRODUCTHUNT_TOKEN=

# ── Hacker News — Username + Password ──
PROMOTE_HN_USERNAME=
PROMOTE_HN_PASSWORD=

# ── MoltBook — API Key ──
PROMOTE_MOLTBOOK_API_KEY=

# ── Medium — Integration Token ──
# 从 https://medium.com/me/settings/security 获取
PROMOTE_MEDIUM_INTEGRATION_TOKEN=

# ── Hashnode — Personal Access Token ──
# 从 https://hashnode.com/settings/developer 获取
PROMOTE_HASHNODE_TOKEN=
PROMOTE_HASHNODE_PUBLICATION_ID=

# ── 微博 (Weibo) — OAuth 2.0 ──
# 需要微博开放平台 App 审批
PROMOTE_WEIBO_ACCESS_TOKEN=

# ── V2EX — Personal Access Token ──
# 从 https://www.v2ex.com/settings/tokens 获取
PROMOTE_V2EX_TOKEN=

# ── SegmentFault — Cookie auth ──
PROMOTE_SEGMENTFAULT_COOKIE=

# ── OSCHINA — Cookie auth ──
PROMOTE_OSCHINA_COOKIE=

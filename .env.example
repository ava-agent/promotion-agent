# === International Platforms ===

# MoltBook (AI Agent Social Network)
PROMOTE_MOLTBOOK_API_KEY=mb_your_key_here

# Reddit (via PRAW)
PROMOTE_REDDIT_CLIENT_ID=your_client_id
PROMOTE_REDDIT_CLIENT_SECRET=your_client_secret
PROMOTE_REDDIT_USERNAME=your_reddit_username
PROMOTE_REDDIT_PASSWORD=your_reddit_password

# Dev.to (Forem API)
PROMOTE_DEVTO_API_KEY=your_devto_api_key

# Hacker News (web form auth)
PROMOTE_HN_USERNAME=your_hn_username
PROMOTE_HN_PASSWORD=your_hn_password

# X / Twitter (OAuth 1.0a - get from developer.x.com)
PROMOTE_X_CONSUMER_KEY=your_consumer_key
PROMOTE_X_CONSUMER_SECRET=your_consumer_secret
PROMOTE_X_ACCESS_TOKEN=your_access_token
PROMOTE_X_ACCESS_TOKEN_SECRET=your_access_token_secret

# Product Hunt (OAuth 2.0 Bearer - get from producthunt.com/v2/oauth/applications)
PROMOTE_PRODUCTHUNT_TOKEN=your_producthunt_token

# LinkedIn (OAuth 2.0 - token expires in 60 days)
PROMOTE_LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# === 国内平台 ===

# 掘金 (Juejin) - 从浏览器F12获取Cookie
PROMOTE_JUEJIN_COOKIE=your_juejin_cookie

# CSDN - 从浏览器F12获取Cookie
PROMOTE_CSDN_COOKIE=your_csdn_cookie

# 知乎 (Zhihu) - 从浏览器F12获取Cookie
PROMOTE_ZHIHU_COOKIE=your_zhihu_cookie

# 博客园 (CNBlogs) - MetaWeblog API
# blog_url: 你的博客ID, 如 "kevinten10"
# token: 在博客园设置中生成的API令牌
PROMOTE_CNBLOGS_BLOG_URL=your_blog_id
PROMOTE_CNBLOGS_USERNAME=your_username
PROMOTE_CNBLOGS_TOKEN=your_api_token

# === General ===
PROMOTE_GITHUB_USERNAME=kevinten10
